BOT_TOKEN=replace_with_token_from_botfather
WEBAPP_URL=https://frontend-2-mauve.vercel.app

# Optional AI agronomist. Create a key at https://aistudio.google.com/apikey
# Keep billing disabled if you only want the available free quota.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_DEEP_MODEL=gemini-3.8-flash

# Render production webhook
PUBLIC_BASE_URL=https://sutech-core.onrender.com
USE_WEBHOOK=true

# Optional database URL (Supabase, Neon, Render PostgreSQL). If omitted, local SQLite is used.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional. If omitted, a valid secret is derived from BOT_TOKEN.
# WEBHOOK_SECRET=letters_numbers_underscores_and_hyphens_only
